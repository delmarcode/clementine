defmodule <%= @agents %>.RunsTest do
  use <%= @app_module %>.AgentsCase

  alias <%= @agents %>.Catalog
  alias <%= @app_module %>.AgentsCase.{Approval, Echo}

  setup do
    register_agents([Echo, Approval])
  end

  test "the catalog finds registered agents by key" do
    assert "test_echo" in Catalog.keys()
    assert {:ok, Echo} = Catalog.fetch("test_echo")
    assert :error = Catalog.fetch("no_such_agent")
    assert :error = Catalog.fetch(nil)
  end

  describe "start/3" do
    test "a started run executes on the agents queue and stores its output" do
      {:ok, run} = Runs.start("test_echo", "Say hello")
      assert_enqueued(worker: RunWorker, args: %{"run_id" => run.id}, queue: :agents)

      expect_turn(text_events("Hello."))
      assert :ok = perform_job(RunWorker, %{"run_id" => run.id})

      assert %AgentRun{status: "completed", result: %{"output" => "Hello."}} =
               Runs.get_run!(run.id)
    end

    test "a subject has at most one active run" do
      assert {:ok, _run} = Runs.start("test_echo", "First", subject: {"ticket", 1})

      assert {:error, :active_run_exists} =
               Runs.start("test_echo", "Second", subject: {"ticket", 1})

      assert {:ok, _run} = Runs.start("test_echo", "Elsewhere", subject: {"ticket", 2})
    end

    test "a subject with no id stores NULL, so such runs never block each other" do
      assert {:ok, first} = Runs.start("test_echo", "One", subject: {"ticket", nil})
      assert {:ok, _second} = Runs.start("test_echo", "Two", subject: {"ticket", nil})
      assert %AgentRun{subject_type: "ticket", subject_id: nil} = Runs.get_run!(first.id)
    end

    test "an unknown agent and a blank prompt are refused" do
      assert {:error, :unknown_agent} = Runs.start("no_such_agent", "Hello")
      assert {:error, :blank_prompt} = Runs.start("test_echo", "  ")
    end
  end

  describe "cancel/2" do
    test "cancelling a queued run finishes it" do
      {:ok, run} = Runs.start("test_echo", "Never mind")

      assert {:ok, :finished} = Runs.cancel(run.id)
      assert %AgentRun{status: "cancelled"} = Runs.get_run!(run.id)
    end
  end

  describe "resume/2" do
    test "a tool that needs approval parks the run until a decision resumes it" do
      run = park!()

      assert {:ok, %Clementine.Suspension{reason: {:approval, _request}}} =
               Runs.suspension(run.id)

      assert :ok = Runs.resume(run.id, {:approved, %{"by" => "test"}})
      assert_enqueued(worker: RunWorker, args: %{"run_id" => run.id})

      expect_turn(text_events("Sent."))
      assert :ok = perform_job(RunWorker, %{"run_id" => run.id})

      assert %AgentRun{status: "completed", result: %{"output" => "Sent."}} =
               Runs.get_run!(run.id)
    end

    test "a sweep racing a resume never interrupts the approved run" do
      run = park!()

      # Oban's pruner has removed the job that completed when the run parked.
      <%= @repo %>.delete_all(Oban.Job)

      # Sweep from another process at the worst moment: after the resume
      # wrote `queued`, while its new job is being inserted. Were the two
      # writes not one transaction, the sweep would find a queued run with
      # no job and interrupt it, losing the approval.
      sweep_while_inserting_a_job()

      assert :ok = Runs.resume(run.id, {:approved, %{"by" => "test"}})
      assert %{interrupted: 0} = sweep_result()
      assert %AgentRun{status: "queued"} = Runs.get_run!(run.id)

      expect_turn(text_events("Sent."))
      assert :ok = perform_job(RunWorker, %{"run_id" => run.id})
      assert %AgentRun{status: "completed"} = Runs.get_run!(run.id)
    end

    test "a run that is not waiting cannot be resumed" do
      {:ok, run} = Runs.start("test_echo", "Not parked")

      assert {:error, :not_waiting} = Runs.resume(run.id, {:approved, %{}})
      assert %AgentRun{status: "queued"} = Runs.get_run!(run.id)
    end
  end

  describe "sweep/1" do
    test "interrupts a run whose job is gone" do
      run = insert_queued_run!()

      assert %{interrupted: 1} = Runs.sweep()
      assert %AgentRun{status: "interrupted"} = Runs.get_run!(run.id)
    end

    test "leaves a run that waits for a free slot in a busy queue, however long" do
      # A burst bigger than the agents queue's limit: this run's job is still
      # available, so no worker has had a chance to claim it.
      {:ok, run} = Runs.start("test_echo", "Busy queue")
      backdate!(run, 16)

      assert %{interrupted: 0} = Runs.sweep()
      assert %AgentRun{status: "queued"} = Runs.get_run!(run.id)
    end

    test "interrupts a run whose worker started but never claimed it" do
      {:ok, run} = Runs.start("test_echo", "Wedged")
      backdate!(run, 16, job_state: "executing")

      assert %{interrupted: 1} = Runs.sweep()
      assert %AgentRun{status: "interrupted"} = Runs.get_run!(run.id)
    end

    test "leaves a parked run alone" do
      run = park!()

      assert %{interrupted: 0, requeued: 0} = Runs.sweep()
      assert %AgentRun{status: "waiting"} = Runs.get_run!(run.id)
    end
  end

  defp park! do
    {:ok, run} = Runs.start("test_approval", "Tell the team")

    expect_turn(tool_events("toolu_1", "send_note", %{text: "hello"}))
    assert :ok = perform_job(RunWorker, %{"run_id" => run.id})
    assert %AgentRun{status: "waiting"} = Runs.get_run!(run.id)

    run
  end

  # On the next job insert, starts a sweep in another process and gives it
  # 200ms to finish before the insert goes on.
  defp sweep_while_inserting_a_job do
    test = self()
    handler = "runs-test-sweep-#{inspect(test)}"

    :telemetry.attach(
      handler,
      [:oban, :engine, :insert_job, :start],
      fn _event, _measurements, _metadata, _config ->
        :telemetry.detach(handler)
        sweep = Task.async(fn -> Runs.sweep() end)
        send(test, {:sweep, Task.yield(sweep, 200) || sweep})
      end,
      nil
    )

    on_exit(fn -> :telemetry.detach(handler) end)
  end

  defp sweep_result do
    receive do
      {:sweep, {:ok, result}} -> result
      {:sweep, %Task{} = sweep} -> Task.await(sweep)
    after
      1_000 -> flunk("the resume inserted no job")
    end
  end
end
