# The agent_runs table of Clementine's durable runtime. Version 6's DDL is
# frozen in Clementine, so this builds the same table under every later
# release; a later version arrives as a new migration calling
# Clementine.Migration.up(from: 6, version: 7).
def up, do: Clementine.Migration.up(version: 6)
def down, do: Clementine.Migration.down(version: 6)
