# The agent_runs table of Clementine's durable runtime. Version 2's DDL is
# frozen in Clementine, so this builds the same table under every later
# release; a later version arrives as a new migration calling
# Clementine.Migration.up(from: 2, version: 3).
def up, do: Clementine.Migration.up(version: 2)
def down, do: Clementine.Migration.down(version: 2)
