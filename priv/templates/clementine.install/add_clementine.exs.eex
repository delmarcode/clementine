# The agent_runs table of Clementine's durable runtime. Version 5's DDL is
# frozen in Clementine, so this builds the same table under every later
# release; a later version arrives as a new migration calling
# Clementine.Migration.up(from: 5, version: 6).
def up, do: Clementine.Migration.up(version: 5)
def down, do: Clementine.Migration.down(version: 5)
