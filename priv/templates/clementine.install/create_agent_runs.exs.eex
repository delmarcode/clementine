# One durable attempt to execute an agent. The product columns are this
# app's; the lifecycle columns are Clementine's column recipe, written only
# through <%= @agents %>.Lifecycle, each write a guarded compare-and-swap
# on (status, lease_epoch).
def change do
  create table(:agent_runs<%= if @binary_id, do: ", primary_key: false" %>) do
<%= if @binary_id do %>    add :id, :binary_id, primary_key: true

<% end %>    # Which agent runs: a key in <%= @agents %>.Catalog.
    add :agent, :text, null: false
    # What the run is about. At most one run per subject is active at a
    # time (the single-active index below); runs without a subject never
    # block each other, because NULLs are distinct in a unique index.
    add :subject_type, :text
    add :subject_id, :text
    # The prompt (%{"prompt" => ...}) and the stored final output.
    add :input, :map, null: false, default: %{}
    add :result, :map
    # The app's job correlation, updated at enqueue and every re-enqueue.
    add :oban_job_id, :bigint
    add :metadata, :map, null: false, default: %{}

    # kind, status, lease_epoch, executor_id, heartbeat_at, deadline,
    # queued_at, cancel, suspension, resume, effects, usage, error,
    # interrupt, finished_at.
    Clementine.Lifecycle.Ecto.Migration.run_columns()

    timestamps(type: :utc_datetime_usec)
  end

  create index(:agent_runs, [:kind, :status])
  create index(:agent_runs, [:agent])
  create index(:agent_runs, [:subject_type, :subject_id])
  create index(:agent_runs, [:oban_job_id])

  # The double-send guard. Active means queued, running, or waiting: a run
  # parked on an approval blocks new runs for its subject until it resolves.
  Clementine.Lifecycle.Ecto.Migration.single_active_index(:agent_runs,
    scope: [:subject_type, :subject_id]
  )
end
