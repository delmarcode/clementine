defmodule <%= @agents %>.ReaperTest do
  use <%= @app_module %>.AgentsCase

  import ExUnit.CaptureLog

  alias <%= @agents %>.Reaper

  test "sweeps as soon as it starts" do
    run = insert_queued_run!()

    pid = start_supervised!({Reaper, enabled: true, name: :reaper_test})
    # The first sweep is the first message the reaper handles.
    :sys.get_state(pid)

    assert %AgentRun{status: "interrupted"} = Runs.get_run!(run.id)
  end

  test "does not start when disabled, as in the test config" do
    assert {:ok, :undefined} = start_supervised({Reaper, enabled: false, name: :reaper_test})
  end

  test "logs a failed sweep and keeps running" do
    app = :<%= @app_name %>
    config = Application.get_env(app, Reaper, [])
    Application.put_env(app, Reaper, Keyword.put(config, :retry, :not_a_policy))
    on_exit(fn -> Application.put_env(app, Reaper, config) end)

    log =
      capture_log(fn ->
        pid = start_supervised!({Reaper, enabled: true, name: :reaper_test})
        :sys.get_state(pid)
        send(pid, :unexpected)
        :sys.get_state(pid)
        assert Process.alive?(pid)
      end)

    assert log =~ "Agent run sweep failed"
  end
end
