defmodule <%= @agents %>.RunWorkerTest do
  use <%= @app_module %>.AgentsCase

  alias <%= @app_module %>.AgentsCase.{Echo, Lookup}

  setup do
    register_agents([Echo, Lookup])
  end

  test "a drained run that has not touched the world is requeued for the next node" do
    {:ok, run} = Runs.start("test_lookup", "Look it up")
    worker = self()

    # The node starts shutting down while the model's turn streams in.
    expect(<%= @agents %>.LLMMock, :stream, fn _model, _system, _messages, _tools, _opts ->
      send(worker, {:clementine, :drain})
      tool_events("toolu_1", "lookup", %{query: "the weather"})
    end)

    assert :ok = perform_job(RunWorker, %{"run_id" => run.id})

    requeued = Runs.get_run!(run.id)
    assert %AgentRun{status: "queued"} = requeued
    assert requeued.oban_job_id != run.oban_job_id
    assert_enqueued(worker: RunWorker, args: %{"run_id" => run.id})
  end

  test "a run that already finished is not executed again" do
    {:ok, run} = Runs.start("test_echo", "Once")
    expect_turn(text_events("Done."))
    assert :ok = perform_job(RunWorker, %{"run_id" => run.id})

    assert {:cancel, reason} = perform_job(RunWorker, %{"run_id" => run.id})
    assert reason =~ "not_claimable"
    assert %AgentRun{status: "completed"} = Runs.get_run!(run.id)
  end

  test "a job whose run is gone is cancelled" do
    run = insert_queued_run!()
    <%= @repo %>.delete!(run)

    assert {:cancel, reason} = perform_job(RunWorker, %{"run_id" => run.id})
    assert reason =~ "run_not_found"
  end

  test "a run whose agent is gone is cancelled as unstartable" do
    run = insert_queued_run!(%{agent: "retired_agent"})

    assert {:cancel, reason} = perform_job(RunWorker, %{"run_id" => run.id})
    assert reason =~ "unknown_agent"
    assert %AgentRun{status: "cancelled"} = Runs.get_run!(run.id)
  end
end
