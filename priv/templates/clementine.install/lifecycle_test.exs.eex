defmodule <%= @agents %>.LifecycleTest do
  @moduledoc """
  Clementine's conformance suite, run against this app's lifecycle, schema,
  and database: concurrent claim races, zombie fencing across suspend and
  resume, cancel racing suspend in both orders, projection atomicity, and
  storage-clock stamps. If a migration or projection change breaks the
  storage contract, this fails.
  """

  alias Ecto.Adapters.SQL.Sandbox

  alias <%= @agents %>.{Lifecycle, Runs}
  alias <%= @app_module %>.AgentsCase

  use Clementine.LifecycleCase,
    lifecycle: Lifecycle,
    create_run: &AgentsCase.create_conformance_run/1,
    storage_now: &Runs.db_now!/0,
    nonexistent_ref: <%= if @binary_id, do: ~s("00000000-0000-0000-0000-000000000000"), else: "-1" %>

  # Racing writers need sibling processes on the sandbox connection. Shared
  # ownership serializes queries at the connection, while every logical
  # interleaving the compare-and-swap must survive still occurs.
  setup do
    pid = Sandbox.start_owner!(<%= @repo %>, shared: true)
    on_exit(fn -> Sandbox.stop_owner(pid) end)
    :ok
  end
end
