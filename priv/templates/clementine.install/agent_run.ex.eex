defmodule <%= @agents %>.AgentRun do
  @moduledoc """
  One durable attempt to execute an agent from `<%= @agents %>.Catalog`.

  The product fields (`agent`, `subject_type`, `subject_id`, `input`,
  `result`, `oban_job_id`, `metadata`) are this app's. The lifecycle fields
  are Clementine's column recipe
  (`Clementine.Lifecycle.Ecto.Migration.run_columns/0`): only
  `<%= @agents %>.Lifecycle` writes them, each write a guarded
  compare-and-swap on `(status, lease_epoch)`. Product code inserts queued
  rows and reads; it never moves a status by hand.
  """

  use Ecto.Schema

  import Ecto.Changeset
<%= if @binary_id do %>
  @primary_key {:id, :binary_id, autogenerate: true}
  @foreign_key_type :binary_id
<% end %>
  @active_statuses ~w(queued running waiting)
  @terminal_statuses ~w(completed failed cancelled interrupted)

  @type t :: %__MODULE__{}

  schema "agent_runs" do
    field :agent, :string
    field :subject_type, :string
    field :subject_id, :string
    field :input, :map, default: %{}
    field :result, :map
    field :oban_job_id, :integer
    field :metadata, :map, default: %{}

    # Clementine's column recipe.
    field :kind, :string, default: "rollout"
    field :status, :string, default: "queued"
    field :lease_epoch, :integer, default: 0
    field :executor_id, :string
    field :heartbeat_at, :utc_datetime_usec
    field :deadline, :utc_datetime_usec
    # Stamped by the database (the column defaults to now()).
    field :queued_at, :utc_datetime_usec, read_after_writes: true
    field :cancel, :map
    field :suspension, :map
    field :resume, :map
    field :effects, :boolean, default: false
    field :usage, :map
    field :error, :map
    field :interrupt, :map
    field :finished_at, :utc_datetime_usec

    timestamps(type: :utc_datetime_usec)
  end

  @doc "The statuses that count as active: queued, running, waiting."
  def active_statuses, do: @active_statuses

  @doc "The terminal statuses."
  def terminal_statuses, do: @terminal_statuses

  @doc """
  A queued run. The `unique_constraint` names the single-active index, so a
  second active run for one subject is a changeset error, not an exception.
  """
  def queued_changeset(attrs) do
    %__MODULE__{}
    |> cast(attrs, [:agent, :subject_type, :subject_id, :input, :metadata])
    |> validate_required([:agent])
    |> unique_constraint([:subject_type, :subject_id],
      name: :agent_runs_single_active_run_index
    )
  end

  @doc "True when the changeset failed on the single-active index."
  def active_run_conflict?(%Ecto.Changeset{errors: errors}) do
    Enum.any?(errors, fn
      {:subject_type, {_message, opts}} -> opts[:constraint] == :unique
      _other -> false
    end)
  end
end
