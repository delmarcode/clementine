# The scripted model. config/test.exs makes it Clementine's LLM client, so
# no test reaches a real provider; a test that runs an agent scripts each
# model turn with expect_turn/1.
Mox.defmock(<%= @agents %>.LLMMock, for: Clementine.LLM.ClientBehaviour)

defmodule <%= @app_module %>.AgentsCase do
  @moduledoc """
  The case for tests that run agents: the SQL sandbox, Oban's testing
  helpers, Mox, and helpers to script the model.

      use <%= @app_module %>.AgentsCase

      test "answers" do
        {:ok, run} = Clementine.Runs.start(<%= @agents %>.Weather, "How is it outside?")
        expect_turn(text_events("Sunny."))

        assert :ok = perform_job(Clementine.Runs.Worker, %{"run_id" => run.id})
        assert %{status: "completed"} = Clementine.Runs.get(run.id)
      end

  Runs execute in more than one process (heartbeats, tools), so a test
  module that executes runs stays `async: false`, the default here: the
  sandbox and the model mock are then shared with every process the run
  starts.
  """

  use ExUnit.CaseTemplate

  alias Clementine.LLM.Anthropic.Fake
  alias Ecto.Adapters.SQL.Sandbox

  using do
    quote do
      use Oban.Testing, repo: <%= @repo %>

      import Mox
      import <%= @app_module %>.AgentsCase

      setup :set_mox_from_context
      setup :verify_on_exit!
    end
  end

  setup tags do
    pid = Sandbox.start_owner!(<%= @repo %>, shared: not tags[:async])
    on_exit(fn -> Sandbox.stop_owner(pid) end)
    :ok
  end

  @doc """
  Scripts the model's next turn: the provider events it streams back.
  Build them with `text_events/1` and `tool_events/3`.
  """
  def expect_turn(events) when is_list(events) do
    Mox.expect(<%= @agents %>.LLMMock, :stream, fn _model, _system, _messages, _tools, _opts ->
      events
    end)
  end

  @doc """
  Scripts the model's next turn as a model that binds its thinking
  (Claude Fable 5.1, Mythos 5.1, Opus 5.5, Sonnet 5.5, Haiku 5.5) would
  answer it.
  `script` is `Clementine.LLM.Anthropic.Fake`'s: say
  `[{:thinking, "..."}, {:text, "Sunny."}]`. The agent's model must be
  an Anthropic one.

  The turn fails when the history the agent replays lost an earlier
  turn's thinking: a reordered or trimmed thread, a rebuilt system
  prompt, a turn stored without its binding. Run a thread's turns
  through it, storing each as the app does, and a replay that would
  cost the model its reasoning fails the test. Pass `strict: false`
  for the turn of a test that changes the thread on purpose.

  `opts` script the rest of the response:

  - `stop_reason:` any the API sends. `"refusal"` fails the run
    `:refused`, and `"max_tokens"` on a final answer fails it
    `:truncated`.
  - `usage:` in the API's keys (`input_tokens`, `output_tokens`,
    `cache_read_input_tokens`, `cache_creation_input_tokens`,
    `cache_creation`), over the default of 10 input and 5 output
    tokens. It reaches the token, cache, and cost metrics as a real
    response's would.
  - `api_errors:` HTTP statuses before the answer: `[529]` is retried
    and answered; `[529, 529, 529]` fails the run `:overloaded`.

  A `{:error, "overloaded_error"}` step in `script` ends the turn
  mid-stream.

      expect_claude_turn([{:text, "I can't help with"}], stop_reason: "refusal")
  """
  def expect_claude_turn(script, opts \\ []) when is_list(script) do
    Mox.expect(<%= @agents %>.LLMMock, :stream, fn model, system, messages, tools, request ->
      Fake.stream(model, system, messages, tools, request, script, opts)
    end)
  end

  @doc "A model turn that answers with `text` and ends the run."
  def text_events(text) do
    [
      {:text_delta, text},
      {:message_delta, %{"stop_reason" => "end_turn"},
       %{"input_tokens" => 10, "output_tokens" => 5}}
    ]
  end

  @doc "A model turn that calls the tool named `name` with `input`."
  def tool_events(id, name, input) do
    [
      {:tool_use_start, id, name},
      {:input_json_delta, id, Jason.encode!(input)},
      {:content_block_stop, 0},
      {:message_delta, %{"stop_reason" => "tool_use"},
       %{"input_tokens" => 10, "output_tokens" => 5}}
    ]
  end
end
