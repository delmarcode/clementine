defmodule <%= @module %>Test do
  use <%= @app_module %>.AgentsCase

  alias <%= @module %>
  alias <%= @tool_module %>

  test "builds an agent with its tool" do
    assert %Clementine.Agent{tools: [<%= @tool_alias %>]} =
             <%= @alias %>.agent(%Clementine.Runs.AgentRun{})
  end

  test "the tool answers a query" do
    assert {:ok, text} = <%= @tool_alias %>.run(%{query: "anything"}, %{})
    assert is_binary(text)
  end

  test "a run calls the tool, then answers" do
    {:ok, run} = Clementine.Runs.start(<%= @alias %>, "Look something up")

    expect_turn(tool_events("toolu_1", "<%= @tool_name %>", %{query: "something"}))
    expect_turn(text_events("Here is what I found."))

    assert :ok = perform_job(Clementine.Runs.Worker, %{"run_id" => run.id})

    assert %Clementine.Runs.AgentRun{
             status: "completed",
             result: %{"output" => "Here is what I found."}
           } = Clementine.Runs.get(run.id)
  end
end
